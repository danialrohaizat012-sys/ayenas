rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isStaff() {
      return signedIn()
        && profile().active == true
        && profile().role in ['owner','admin','manager','crew'];
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
