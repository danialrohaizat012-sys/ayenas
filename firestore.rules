rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function userDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isStaff(){ return signedIn() && userDoc().data.active == true && userDoc().data.role in ['owner','admin','manager','crew']; }
    function isOwner(){ return isStaff() && userDoc().data.role == 'owner'; }
    function sameOutlet(data){ return isOwner() || userDoc().data.outletId == 'all' || data.outletId == userDoc().data.outletId; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update, delete: if isOwner();
    }
    match /products/{id} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }
    match /outletSettings/{id} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        (isStaff() && sameOutlet(resource.data))
      );
      allow update: if isStaff() && sameOutlet(resource.data);
      allow delete: if isOwner();
    }
    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if signedIn() && (request.auth.uid == uid || isStaff());
      allow delete: if isOwner();
    }
  }
}